// Reynolds et al. 2006 — Reduced model of the acute inflammatory response
// 4 ODEs: P (pathogen), Nstar (activated phagocytes), D (tissue damage),
// C_A (anti-inflammatory mediators). Rate-rule form, faithful to the paper.
model reynolds_2006_acute_inflammation

  // --- State variables ---
  species P, Nstar, D, C_A;

  // --- Auxiliary terms (anti-inflammatory down-modulation f(.)) ---
  f_Nstar  := Nstar / (1 + (C_A/c_inf)^2);
  f_D_hill := f_Nstar^6 / (x_dn^6 + f_Nstar^6);
  R        := (k_nn*Nstar + k_np*P + k_nd*D) / (1 + (C_A/c_inf)^2);
  g_CA     := (Nstar + k_cnd*D) / (1 + (C_A/c_inf)^2);

  // --- ODEs ---
  P'     = k_pg*P*(1 - P/p_inf) - k_pm*s_m*P/(mu_m + k_mp*P) - k_pn*f_Nstar*P;
  Nstar' = s_nr*R/(mu_nr + R) - mu_n*Nstar;
  D'     = k_dn*f_D_hill - mu_d*D;
  C_A'   = s_c + k_cn*g_CA/(1 + g_CA) - mu_c*C_A;

  // --- Initial conditions (healthy baseline; override P for dosing) ---
  P = 1; Nstar = 0; D = 0; C_A = 0.125;

  // --- Parameters (published values, Reynolds 2006) ---
  k_pg = 0.3; p_inf = 20;
  k_pm = 0.6; s_m = 0.005; mu_m = 0.002; k_mp = 0.01;
  k_pn = 1.8;
  s_nr = 0.08; mu_nr = 0.12; mu_n = 0.05;
  k_nn = 0.01; k_np = 0.1; k_nd = 0.02;
  k_dn = 0.35; x_dn = 0.06; mu_d = 0.02;
  s_c = 0.0125; k_cn = 0.04; k_cnd = 48; mu_c = 0.1; c_inf = 0.28;
end
